{
  "name": "@equationalapplications/expo-two-way-audio",
  "version": "0.2.1",
  "description": "Expo module for real-time two-way PCM audio: echo-cancelled mic capture, low-latency playback, and barge-in. Maintained fork of @speechmatics/expo-two-way-audio.",
  "main": "build/index.js",
  "types": "build/index.d.ts",
  "files": [
    "build",
    "src",
    "android/build.gradle",
    "android/src/main",
    "ios",
    "expo-module.config.json",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "rm -rf build",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "format": "biome check .",
    "format:fix": "biome check --write .",
    "prepack": "npm run clean && npm run build"
  },
  "keywords": [
    "react-native",
    "expo",
    "expo-module",
    "audio",
    "pcm",
    "voice",
    "echo-cancellation",
    "barge-in",
    "two-way-audio",
    "realtime",
    "full-duplex",
    "voice-agent",
    "speech"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/equationalapplications/expo-two-way-audio.git"
  },
  "bugs": {
    "url": "https://github.com/equationalapplications/expo-two-way-audio/issues"
  },
  "homepage": "https://github.com/equationalapplications/expo-two-way-audio#readme",
  "author": "Equational Applications (https://github.com/equationalapplications)",
  "contributors": ["Speechmatics <devrel@speechmatics.com> (https://github.com/speechmatics)"],
  "license": "MIT",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "peerDependencies": {
    "expo": ">=55.0.0",
    "react": "*",
    "react-native": "*"
  },
  "devDependencies": {
    "@biomejs/biome": "1.9.4",
    "@types/react": "19.3.0",
    "expo": "58.0.21",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "typescript": "6.0.3"
  }
}
